# Frontend environment variables
# Copy to .env.local for local dev, or set in Netlify Site Settings -> Environment variables.

# Used by Next.js server-side rewrites (next.config.js)
BACKEND_URL=http://localhost:3001

# Optional: direct API base URL for browser requests (e.g. https://green-marketplace-api.onrender.com)
NEXT_PUBLIC_API_URL=
